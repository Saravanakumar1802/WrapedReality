# Copy this file to .env.local and fill in the values you have.
# Every key is OPTIONAL: the site builds and works without any of them.
# Keys are read only by the build scripts (`npm run data`). They are never shipped to the browser.
# Step-by-step instructions for each key: README.md → "API keys".

# ── YouTube Data API v3: your videos, playlists, chapters, lengths ──
YT_API_KEY=
YT_CHANNEL_ID=

# ── YouTube captions (owner only): full transcripts for the moment index ──
# A "Desktop app" OAuth client from Google Cloud, then run `npm run youtube:auth` once
# to fill in YT_OAUTH_REFRESH_TOKEN automatically.
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REFRESH_TOKEN=

# ── AI moment index: turns each video's captions into searchable moments ──
# Free: a Google AI Studio key (https://aistudio.google.com/apikey). Used by default.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional backup, also free (":free" models, 50 requests/day): OPENROUTER_API_KEY= and OPENROUTER_MODEL=
# Optional, paid: ANTHROPIC_API_KEY= and ANTHROPIC_MODEL=
# LLM_PROVIDER=gemini        # force one provider (gemini | openrouter | anthropic)
# LLM_MAX_VIDEOS=25          # videos indexed per run, to stay inside free daily limits

# ── IGDB (art for games Steam and Wikipedia don't cover, genres, themes): a Twitch developer app ──
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── Steam Web API (hours played for PC games). Profile and game details must be public. ──
STEAM_API_KEY=
STEAM_ID=

# ── Sketchfab API token (downloads the console 3D models: `npm run models`) ──
SKETCHFAB_TOKEN=

# ── Public values (safe to expose; used in the browser) ──
VITE_SITE_URL=http://localhost:3000
VITE_YT_CHANNEL_URL=
