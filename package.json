    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
